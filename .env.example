# ==============================================================================
# Solis Gratitude Journal - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Core Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-strong-random-50-character-string-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Cross-Origin Resource Sharing (CORS) & CSRF Trusted Origins
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com
